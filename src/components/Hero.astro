---
import { useTranslations } from '../i18n/utils';
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
---

<section class="min-h-[85svh] flex items-center justify-center relative overflow-hidden px-4">
  <div class="max-w-4xl mx-auto text-center z-10 space-y-8 bg-base-100/60 p-8 md:p-16 rounded-3xl backdrop-blur-sm shadow-xl border border-base-100/50">
    <div class="space-y-4">
      <h1 class="text-5xl md:text-7xl font-heading font-bold text-primary leading-tight">
        {t('hero.title')} <br/>
        <span class="text-accent">{t('hero.name')}</span>
      </h1>
      <h2 class="text-2xl md:text-3xl font-body font-medium text-secondary mt-4">
        {t('hero.subtitle')}
      </h2>
    </div>
    
    <p class="text-lg md:text-xl font-body text-neutral-600 max-w-2xl mx-auto leading-relaxed">
      {t('hero.desc')}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
      <a href="#contact" class="btn btn-primary btn-lg font-heading text-xl shadow-md hover:shadow-lg">
        {t('hero.cta1')}
      </a>
      <a href="#practice-areas" class="btn btn-outline btn-primary btn-lg font-heading text-xl">
        {t('hero.cta2')}
      </a>
    </div>
  </div>
</section>
