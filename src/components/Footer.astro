---
import { useTranslations } from '../i18n/utils';
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="footer p-10 bg-secondary text-secondary-content">
  <aside>
    <p class="font-heading font-bold text-3xl mb-2">{t('hero.title')} {t('hero.name')}</p>
    <p class="font-body text-lg opacity-80" set:html={t('footer.desc')}></p>
  </aside>
  <nav class="font-body">
    <h6 class="footer-title opacity-100 font-heading text-xl">{t('footer.links')}</h6>
    <a href="#about" class="link link-hover">{t('nav.about')}</a>
    <a href="#experience" class="link link-hover">{t('nav.experience')}</a>
    <a href="#practice-areas" class="link link-hover">{t('nav.practice')}</a>
    <a href="#writer" class="link link-hover">{t('nav.writer')}</a>
    <a href="#contact" class="link link-hover">{t('nav.contact')}</a>
  </nav>
  <nav class="font-body">
    <h6 class="footer-title opacity-100 font-heading text-xl">{t('contact.info')}</h6>
    <span class="opacity-80" set:html={t('contact.address_val').replace('<br/>', '، ')}></span>
    <span class="opacity-80" dir="ltr">0770 26 99 80 | 0551 36 71 27</span>
    <span class="opacity-80">imbelmouloud@gmail.com</span>
    <span class="opacity-80">imbelmouloud@yahoo.fr</span>
  </nav>
</footer>
<footer class="footer footer-center p-4 bg-secondary text-secondary-content border-t border-secondary-content/10 font-body">
  <aside>
    <p>{t('footer.rights', { year: currentYear })}</p>
  </aside>
</footer>
