<section id="experience" class="py-20 px-4 bg-primary text-primary-content relative z-10 overflow-hidden">
  <!-- Subtle background pattern or decoration -->
  <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  
  <div class="max-w-6xl mx-auto relative z-10 text-center">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 items-center">
      
      <!-- Stat 1 -->
      <div class="p-6">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">+28</div>
        <h3 class="text-2xl font-heading font-bold mb-2">سنة من الخبرة</h3>
        <p class="text-primary-content/80 font-body text-lg">تاريخ حافل بالتفاني والعطاء في أروقة المحاكم والدفاع عن الحق.</p>
      </div>
      
      <!-- Stat 2 -->
      <div class="p-6 border-y md:border-y-0 md:border-x border-primary-content/20">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">المحكمة العليا</div>
        <h3 class="text-2xl font-heading font-bold mb-2">ومجلس الدولة</h3>
        <p class="text-primary-content/80 font-body text-lg">اعتماد رسمي للترافع في أعلى الهيئات القضائية بالجزائر.</p>
      </div>
      
      <!-- Stat 3 -->
      <div class="p-6">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">آلاف</div>
        <h3 class="text-2xl font-heading font-bold mb-2">القضايا الناجحة</h3>
        <p class="text-primary-content/80 font-body text-lg">ثقة مستمرة من عملائنا بفضل التوجيه القانوني السليم والنتائج الملموسة.</p>
      </div>
      
    </div>
  </div>
</section>
