---
import { useTranslations } from '../i18n/utils';
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="py-20 px-4 bg-primary text-primary-content relative z-10 overflow-hidden">
  <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  
  <div class="max-w-6xl mx-auto relative z-10 text-center">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 items-center">
      
      <div class="p-6">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">{t('exp.yoe_num')}</div>
        <h3 class="text-2xl font-heading font-bold mb-2">{t('exp.yoe_txt')}</h3>
        <p class="text-primary-content/80 font-body text-lg">{t('exp.yoe_desc')}</p>
      </div>
      
      <div class="p-6 border-y md:border-y-0 md:border-x border-primary-content/20">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">{t('exp.court_num')}</div>
        <h3 class="text-2xl font-heading font-bold mb-2">{t('exp.court_txt')}</h3>
        <p class="text-primary-content/80 font-body text-lg">{t('exp.court_desc')}</p>
      </div>
      
      <div class="p-6">
        <div class="text-6xl font-heading font-bold mb-4 text-accent">{t('exp.cases_num')}</div>
        <h3 class="text-2xl font-heading font-bold mb-2">{t('exp.cases_txt')}</h3>
        <p class="text-primary-content/80 font-body text-lg">{t('exp.cases_desc')}</p>
      </div>
      
    </div>
  </div>
</section>
