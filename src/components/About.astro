---
import { Image } from 'astro:assets';
import infoImage from '../assets/info.jpg';
import expImage from '../assets/experience.jpg';
import { useTranslations } from '../i18n/utils';

const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-20 px-4 bg-base-100 relative z-10">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-primary mb-4">{t('about.title')}</h2>
      <div class="w-24 h-1 bg-accent mx-auto rounded-full"></div>
    </div>
    
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <div class="lg:w-1/2 relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-base-200">
          <Image src={infoImage} alt={t('hero.name')} class="w-full h-auto object-cover aspect-[4/3]" />
        </div>
        <div class="absolute -bottom-8 -right-8 w-48 h-48 rounded-2xl overflow-hidden shadow-xl border-4 border-base-100 hidden md:block z-10" style={lang !== 'ar' ? 'right: auto; left: -2rem;' : ''}>
           <Image src={expImage} alt="Experience" class="w-full h-full object-cover" />
        </div>
      </div>
      
      <div class="lg:w-1/2 space-y-6 font-body">
        <h3 class="text-3xl font-heading font-bold text-secondary">{t('about.vision')}</h3>
        <p class="text-lg text-neutral-600 leading-relaxed">
          {t('about.p1')}
        </p>
        <p class="text-lg text-neutral-600 leading-relaxed" set:html={t('about.p2')}>
        </p>
      </div>
    </div>
  </div>
</section>
